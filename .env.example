# =============================================================================
# Public variables (exposed to the browser)
# Prefix MUST be NEXT_PUBLIC_
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Cauce

# =============================================================================
# Private variables (server-only — never prefix with NEXT_PUBLIC_)
# =============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/cauce
# AUTH_SECRET=

# =============================================================================
# Usage
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in real values locally.
# 3. In Vercel: Project → Settings → Environment Variables
#    (set Production / Preview / Development as needed).
# =============================================================================
